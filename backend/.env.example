PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=2h

# Database (SQLite - no config needed, file auto-created)
# DB_PATH=./database/bustrack.db

# Optional: MySQL (if migrating from SQLite)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=smart_bus_tracking

# Frontend URL for CORS
CLIENT_URL=http://127.0.0.1:5500

# Admin Default Credentials (changed after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# GPS Settings
GPS_SIMULATION_INTERVAL=3000
ENABLE_GPS_SIMULATION=false
GPS_TIMEOUT_SECONDS=45

# Email / SMTP Configuration (for GIET user credentials delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mishrashreeshashish@gmail.com
SMTP_PASSWORD=wosd hsfq mnef zthn
SMTP_FROM="GIET Smart Bus System" <noreply@giet.edu>
APP_URL=http://localhost:5000

# Android App Release / Google Play Store URL (Leave empty for 'Coming Soon' state)
# Example: https://play.google.com/store/apps/details?id=edu.giet.smartbus
# Example: https://github.com/shreeshashish/Smart-University-Bus-Tracking-System/releases/download/v1.0.0/smart-bus-tracker.apk
ANDROID_APP_URL=

