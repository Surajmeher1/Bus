# ============================================================
# Smart University Bus Tracking System — Environment Configuration
# Copy this file to .env and configure your production/local secrets.
# DO NOT commit .env with real credentials to GitHub.
# ============================================================

# Server & Environment
PORT=5000
NODE_ENV=production

# JWT Authentication (generate a secure 32+ character random secret for production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=2h

# Database Configuration
# Option A (Recommended for Render/Railway): SQLite with persistent volume mount
# Mount persistent disk at /var/data and set:
DB_PATH=/var/data/bustrack.db
# Option B (PostgreSQL):
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# CORS & Application URLs
# Production: Set to your public deployed domain (e.g., https://smart-bus-tracker.onrender.com)
# For multiple frontend origins, separate by comma: https://domain1.com,https://domain2.com
CLIENT_URL=https://smart-bus-tracker.onrender.com
APP_URL=https://smart-bus-tracker.onrender.com

# Email / SMTP Configuration (for sending credentials on user creation)
# If using Gmail, generate an App Password from your Google Account security page
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM="GIET Smart Bus System" <noreply@giet.edu>

# Admin Initial Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# GPS Real-Time Settings
GPS_SIMULATION_INTERVAL=3000
ENABLE_GPS_SIMULATION=false
GPS_TIMEOUT_SECONDS=45

# Android Application Release URL (Optional - leave empty for 'Coming Soon' state)
ANDROID_APP_URL=
